{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sse/fluid-item",
  "version": "0.1.0",
  "title": "Freeform item",
  "category": "design",
  "icon": "move",
  "description": "A block placed on a freeform section's grid. Click it and drag to move it, drag its edges to resize it, and click again to edit it.",
  "textdomain": "section-site-editor",
  "parent": [
    "sse/fluid-section"
  ],
  "attributes": {
    "layout": {
      "type": "object",
      "default": {
        "c": 1,
        "r": 1,
        "w": 12,
        "h": 4
      }
    },
    "mobileLayout": {
      "type": "object"
    },
    "zIndex": {
      "type": "number",
      "default": 0
    },
    "verticalAlignment": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true
    },
    "__experimentalBorder": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}