{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sse/fluid-section",
  "version": "0.1.0",
  "title": "Freeform section",
  "category": "design",
  "icon": "grid-view",
  "description": "A section on a snap grid. Drag blocks anywhere and resize them, with a separate layout for mobile.",
  "keywords": [
    "fluid",
    "grid",
    "freeform",
    "section",
    "layout"
  ],
  "textdomain": "squarespace-style-site-editor",
  "allowedBlocks": [
    "sse/fluid-item"
  ],
  "attributes": {
    "rows": {
      "type": "number",
      "default": 10
    },
    "mobileRows": {
      "type": "number",
      "default": 0
    },
    "gap": {
      "type": "string",
      "enum": [
        "none",
        "narrow",
        "wide"
      ]
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true
    },
    "dimensions": {
      "minHeight": true
    }
  },
  "example": {
    "attributes": {
      "rows": 6
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}